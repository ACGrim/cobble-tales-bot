# Copy this to .env for local testing (never commit the real .env).
# In production these are set as GitHub Actions repo Secrets, NOT read from this file.

ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare R2 (temporary public video hosting for Instagram/TikTok to fetch from)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=cobble-tales-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Instagram Graph API
IG_ACCESS_TOKEN=...
IG_USER_ID=...

# TikTok Content Posting API (set directly for local testing; in GitHub
# Actions this is refreshed automatically every run -- see SETUP.md Part 5)
TIKTOK_ACCESS_TOKEN=...
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# TikTok auto-refresh (only needed in GitHub Actions, see SETUP.md Part 5)
TIKTOK_CLIENT_KEY=...
TIKTOK_CLIENT_SECRET=...
TIKTOK_REFRESH_TOKEN=...
GH_SECRETS_PAT=...

# Optional overrides
CLAUDE_MODEL=claude-sonnet-4-5
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+5%
REDDIT_STORIES_PER_DAY=3

# Optional: direct links to your own real gameplay clips (comma or space
# separated), for footage too big to commit. Unset = use assets/parkour/, or
# generated block-parkour gameplay if that folder is empty too.
PARKOUR_CLIP_URLS=
